<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings owned by the system-facing surfaces: the first-run flow, the capture and lens
  notifications, and the model download status lines. English only in this file; the Spanish
  pass gets a values-es/strings_system.xml with exactly these keys.
-->
<resources>

    <!-- First-run flow (Onboarding.kt) -->
    <string name="sys_onboarding_step1_title">Just start talking</string>
    <string name="sys_onboarding_step1_body">Tap record, speak your mind, and tap again to stop. It becomes a note on its own.</string>
    <string name="sys_onboarding_step2_title">Nothing leaves this phone</string>
    <string name="sys_onboarding_step2_body">Transcription and writing run on-device. No account, no cloud: nothing you record is uploaded.</string>
    <string name="sys_onboarding_step3_title">Organize with Spaces &amp; Lenses</string>
    <string name="sys_onboarding_step3_body">Group notes and images into Spaces, run AI Lenses over them, and grant mic and notification access only when you need them.</string>
    <string name="sys_onboarding_permissions_hint">Microphone is requested when you record; notifications keep reports and captures visible in the background.</string>
    <string name="sys_onboarding_action_continue">Continue</string>
    <string name="sys_onboarding_action_get_started">Get started</string>
    <string name="sys_onboarding_skip">Skip</string>
    <string name="sys_onboarding_back_content_description">Back</string>
