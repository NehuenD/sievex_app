<resources>

    <!-- First-run flow (Onboarding.kt) -->
    <string name="sys_onboarding_step1_title">Habla libre, pliega en tinta</string>
    <string name="sys_onboarding_step1_body">Toca grabar, piensa en voz alta mientras caminas y vuelve a tocar al terminar. Inkvox destila tu voz en notas, listas o pasos claros.</string>
    <string name="sys_onboarding_step2_title">Privado de raíz, todo en tu móvil</string>
    <string name="sys_onboarding_step2_body">Tanto la transcripción como la escritura corren en tu teléfono. Sin cuenta, sin nube, sin subir nada.</string>
    <string name="sys_onboarding_step3_title">Teje Espacios, Lentes y pasos claros</string>
    <string name="sys_onboarding_step3_body">Reúne ideas y capturas en Espacios, descubre patrones con Lentes de IA y concede micrófono y notificaciones solo cuando los necesites.</string>
    <string name="sys_onboarding_permissions_hint">El micrófono se pide al grabar; las notificaciones mantienen visibles los informes y capturas en segundo plano.</string>
